# FATA University Hostel — Apache Configuration

# Enable URL rewriting
Options -Indexes
Options +FollowSymLinks

# Protect sensitive files
<FilesMatch "\.(sql|log|env|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect API folder from direct browser access
<Files "db.php">
    Order allow,deny
    Deny from all
</Files>

# PHP settings
php_value session.cookie_httponly 1
php_value session.use_strict_mode 1

# Cache static assets — images cached, HTML/CSS/JS always fresh
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html        "access plus 0 seconds"
    ExpiresByType image/jpg        "access plus 1 month"
    ExpiresByType image/jpeg       "access plus 1 month"
    ExpiresByType image/png        "access plus 1 month"
    ExpiresByType text/css         "access plus 0 seconds"
    ExpiresByType text/javascript  "access plus 0 seconds"
</IfModule>

# Force no-cache for HTML and PHP pages
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
